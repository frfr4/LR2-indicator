+++ b/LR2/chart_radar/tests/tech_check.cpp
@@ -0,0 +1,55 @@
+#include "catalog.hpp"
+#include "tech.hpp"
+#include <fstream>
+#include <iostream>
+
+using namespace chart_radar;
+static std::vector<Note> pattern(std::vector<unsigned> masks,std::vector<double> gaps) {
+    std::vector<Note> notes;
+    double time=0.;
+    for(int row=0;row<640;++row) {
+        for(int lane=0;lane<7;++lane)if(masks[row%masks.size()]&(1u<<lane))
+            notes.push_back({time,time,lane,0.});
+        time+=gaps[row%gaps.size()];
+    }
+    return notes;
+}
+static Scores evaluate(const std::vector<Note>& notes) {
+    Scores s{};s[Chord]=600.;s[Jack]=600.;tech::apply(s,notes);return s;
+}
+int main(int argc,char** argv) {
+    if(argc!=3)return 1;
+    const std::vector<double> even{.06},uneven{.034,.086};
+    const auto jack=evaluate(pattern({1},even));
+    const auto chords=evaluate(pattern({3},even));
+    const auto mixed=evaluate(pattern({3,5,9,17},even));
+    const auto roll=evaluate(pattern({1,2,4,8,16,32,64},even));
+    const auto delay=evaluate(pattern({1,2,4,8,16,32,64},uneven));
+    const auto burst=evaluate(pattern({1,4,2,8,32,16,64},even));
+    if(jack[Tech]!=0. || chords[Tech]!=0. || jack[Jack]!=600. || chords[Chord]!=600.)return 2;
+    if(mixed[Tech]<=chords[Tech] || mixed[Chord]>=chords[Chord] || mixed[Jack]>=jack[Jack])return 3;
+    if(delay[Tech]<=roll[Tech] || burst[Tech]<=roll[Tech])return 4;
+    if(!tech::minaTechnical(pattern({3,5,9,17},even)).has_value())return 5;
+    const auto notes=pattern({3,5,9,17},even);
+    auto extra=notes;for(auto& n:extra)n.end+=2.;
+    extra.push_back({45.,45.,7,0.});
+    if(evaluate(extra)!=mixed)return 6;
+    auto tmp=std::filesystem::path(argv[1]);std::filesystem::create_directories(tmp);
+    const std::string id(32,'a'); const auto file=tmp/"charts-v40.tsv";
+    std::ofstream(file)<<id<<" 100 4500 200 400 300 150 100 10 0 0 0 22\n";
+    const auto cache=(tmp/"cache.db").string();
+    {
+        ChartCatalog cc((tmp/"empty.tsv").string(),cache);
+        auto fallback=cc.fallback(id);
+        if(cc.find(id) || !fallback || (*fallback)[Tech]!=0.)return 7;
+        if(!cc.resolve(id,argv[2],7))return 8;
+        auto scores=cc.find(id);
+        if(!scores || (*scores)[Tech]==4500. || (*scores)[Density]!=100.)return 9;
+    }
+    {ChartCatalog cc((tmp/"empty.tsv").string(),cache);if(!cc.find(id))return 10;}
+    PlayerSamples player;player.add(mixed,{4,90,10,100},id);
+    if(player.finish().axes[Tech]<=0.)return 11;
+    std::cout<<"TECH pure jack "<<jack[Tech]<<" pure chord "<<chords[Tech]<<" techjack "<<mixed[Tech]
+             <<" regular roll "<<roll[Tech]<<" stagger "<<delay[Tech]<<" mixed stream "<<burst[Tech]
+             <<" mixed JACK "<<mixed[Jack]<<" mixed CHORD "<<mixed[Chord]<<"\n";
+}
