diff --git a/LR2/chart_radar/tech.hpp b/LR2/chart_radar/tech.hpp
new file mode 100644
index 0000000..2472bb4
--- /dev/null
+++ b/LR2/chart_radar/tech.hpp
@@ -0,0 +1,85 @@
+#pragma once
+#include "radar.hpp"
+#include <bitset>
+#include <optional>
+#include <vector>
+
+namespace chart_radar::tech {
+struct Result {
+    double dose=0., jackShare=0., chordShare=0.;
+};
+std::optional<double> minaTechnical(const std::vector<Note>& notes);
+
+struct Row { double time; unsigned keys; };
+inline int count(unsigned mask) { return int(std::bitset<7>(mask).count()); }
+
+// Measure only transitions that mix patterns. A repeated anchor alone and a
+// repeating chord alone remain JACK and CHORD at any speed.
+inline Result measure(const std::vector<Note>& notes) {
+    std::vector<Row> rows;
+    for (const auto& n:notes) {
+        if(n.lane<0 || n.lane>=7) continue;
+        if(rows.empty() || n.start-rows.back().time>.0000005)
+            rows.push_back({n.start,0});
+        rows.back().keys|=1u<<n.lane;
+    }
+    if(rows.size()<4) return {};
+    double jack=0.,mixedJack=0.,chord=0.,mixedChord=0.;
+    double bucket=0.,sumSquares=0.,maximum=0.;
+    int active=0;
+    auto closeWindow=[&]() {
+        sumSquares+=bucket*bucket;
+        maximum=std::max(maximum,bucket);
+        ++active; bucket=0.;
+    };
+    long long window=0;
+    for(size_t i=2;i<rows.size();++i) {
+        const auto a=rows[i-2], b=rows[i-1], c=rows[i];
+        const auto index=static_cast<long long>((c.time-rows.front().time)/.5);
+        if(index!=window){closeWindow();window=index;}
+        const double dt=c.time-b.time, before=b.time-a.time;
+        if(dt<=0. || before<=0. || dt>.32 || before>.32) continue;
+        const double uneven=std::clamp((std::abs(dt-before)/(dt+before)-.10)/.48,0.,1.);
+        const int repeated=count(b.keys&c.keys);
+        const bool switches=c.keys!=b.keys;
+        const double fast=1./(1.+std::pow(dt/.15,3));
+        const double moved=double(count(b.keys^c.keys))/count(b.keys|c.keys);
+        const double anchor=repeated && switches ? moved : 0.;
+        const double stagger=switches?uneven:0.;
+        // Same-handed direction changes over three distinct, nonperiodic masks.
+        double turn=0.;
+        for(unsigned hand:{7u,120u}) {
+            const auto x=a.keys&hand,y=b.keys&hand,z=c.keys&hand;
+            if(!x || !y || !z || x==y || y==z || x==z) continue;
+            auto center=[](unsigned m) {
+                int total=0;
+                for(int k=0;k<7;++k)if(m&(1u<<k))total+=k;
+                return double(total)/count(m);
+            };
+            if((center(y)-center(x))*(center(z)-center(y))<0.) turn=1.;
+        }
+        const double irregularRepeat=(!switches && repeated)?uneven:0.;
+        const double mix=std::min(1.,anchor+.85*stagger+.60*turn+.65*irregularRepeat);
+        const double speed=std::min(28.,1./dt);
+        bucket+=fast*mix*std::sqrt(double(count(c.keys)))*std::sqrt(speed/10.);
+        const double repeatLoad=fast*repeated*speed;
+        const double chordLoad=fast*std::max(0,count(c.keys)-1)*speed;
+        jack+=repeatLoad; mixedJack+=repeatLoad*mix;
+        chord+=chordLoad; mixedChord+=chordLoad*mix;
+    }
+    closeWindow();
+    const double rms=std::sqrt(sumSquares/std::max(1,active));
+    return {std::sqrt(rms*maximum),mixedJack/std::max(1.,jack),mixedChord/std::max(1.,chord)};
+}
+inline void apply(Scores& scores,const std::vector<Note>& notes) {
+    const auto m=measure(notes);
+    scores[Tech]=0.;
+    if(m.dose<=0.)return;
+    const auto msd=minaTechnical(notes);
+    const double evidence=1.-std::exp(-m.dose/3.);
+    const double physical=235.*std::log1p(m.dose);
+    scores[Tech]=std::hypot(physical,msd ? 15.*(*msd)*evidence : 0.);
+    scores[Jack]*=1.-.52*m.jackShare;
+    scores[Chord]*=1.-.52*m.chordShare;
+}
+}
diff --git a/LR2/chart_radar/tech_mina.cpp b/LR2/chart_radar/tech_mina.cpp
new file mode 100644
index 0000000..7c40407
--- /dev/null
+++ b/LR2/chart_radar/tech_mina.cpp
@@ -0,0 +1,41 @@
+#include "tech.hpp"
+#include "../../dep/Etterna/MinaCalc/MinaCalc.h"
+#include <mutex>
+
+namespace chart_radar::tech {
+namespace {
+std::optional<double> technicalForKeys(const std::vector<Note>& notes,int first,int keys,Calc& calc) {
+    std::vector<NoteInfo> rows;
+    double origin=0.;
+    for(const auto& head:notes) {
+        if(head.lane<first || head.lane>=first+keys)continue;
+        if(rows.empty())origin=head.start;
+        const double seconds=head.start-origin+.5;
+        if(!std::isfinite(seconds) || seconds<0. || seconds>=(max_intervals-2)*.5)return {};
+        const float t=static_cast<float>(seconds);
+        const unsigned bit=1u<<(head.lane-first);
+        if(!rows.empty() && rows.back().rowTime==t)rows.back().notes|=bit;
+        else rows.push_back({bit,t});
+    }
+    if(rows.size()<4)return {};
+    calc.ssr=false;calc.keycount=keys;
+    const auto skills=calc.CalcMain(rows,1.F,.93F);
+    if(skills.size()!=NUM_Skillset || skills[Skill_Overall]<=0.F ||
+       !std::isfinite(skills[Skill_Technical]) || skills[Skill_Technical]<0.F)return {};
+    return skills[Skill_Technical];
+}
+}
+// The seven-key handler and the two overlapping four-lane views see the
+// middle key; take a maximum to avoid charging its notes twice.
+std::optional<double> minaTechnical(const std::vector<Note>& notes) {
+    static std::mutex mutex;
+    std::lock_guard<std::mutex> lock(mutex);
+    static Calc seven,four;
+    auto result=technicalForKeys(notes,0,7,seven);
+    for(int first:{0,3}) {
+        const auto hand=technicalForKeys(notes,first,4,four);
+        if(hand && (!result || *hand>*result))result=hand;
+    }
+    return result;
+}
+}
