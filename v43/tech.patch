+int main(int argc,char** argv) {
+    if(argc!=4)return 1;
+    const std::filesystem::path assets=argv[1],charts=argv[2];
+    ChartCatalog catalog((assets/"charts-v26.tsv").string());
+    std::ofstream out(argv[3]);out<<std::fixed<<std::setprecision(2);
+    size_t used=0,missing=0;
+    std::vector<std::filesystem::path> paths;
+    for(const auto& entry:std::filesystem::directory_iterator(charts))paths.push_back(entry.path());
+    std::sort(paths.begin(),paths.end());
+    for(const auto& file:paths) {
+        const std::string hash=file.stem().string();
+        const auto scores=catalog.resolve(hash,file.string(),7,true);
+        const auto traits=catalog.traits(hash,7);const auto hard=catalog.hardEstimate(hash,7);
+        const auto poor=catalog.poorExtra(hash,7);
+        if(!scores || !traits || !poor || !hard){++missing;continue;}
+        out<<hash;
+        for(auto a:detailOrder)out<<'\t'<<(*scores)[a];
+        out<<'\t'<<int(traits->endSpike)<<'\t'<<traits->recoveryShortfall<<'\t'<<*poor<<'\t'<<*hard<<'\n';
+        ++used;
+    }
+    std::cout<<"Measured "<<used<<" source charts, unsupported "<<missing<<"\n";
+    return used && out.good()?0:2;
+}
