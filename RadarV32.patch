+            auto prior=PriorChartCatalog::resolve(hash,file,mode);
+            auto info=PriorChartCatalog::traits(hash,mode);
+            if (!prior || !info) return {};
+            auto scores=*prior;
+            scores[Soflan]=displayCents(ratioSoflan(chart.notes,timing))/100.;
+            std::lock_guard<std::mutex> lock(mutex);
