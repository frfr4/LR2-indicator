diff --git a/LR2/chart_radar/ratio_soflan.hpp b/LR2/chart_radar/ratio_soflan.hpp
new file mode 100644
index 0000000..47ec5f4
--- /dev/null
+++ b/LR2/chart_radar/ratio_soflan.hpp
@@ -0,0 +1,50 @@
+#pragma once
+#include "read_sp7.hpp"
+
+namespace chart_radar {
+// Integrate the squared input density over all chart-relative windows of width 1%.
+// Only different onsets on the same side of MAINBPM can form a pair.
+inline double ratioSoflan(const std::vector<Note>& notes, const RadarTempo& timing) {
+    if (notes.size()<2 || timing.tempos.empty() || timing.mainVotes.size()<2) return 0.;
+    const double first=notes.front().start;
+    const double duration=notes.back().start-first;
+    if (duration<=0.) return 0.;
+    // Match the game's MAINBPM count and tie handling on the same platform.
+    double mainBpm=0.;
+    int highest=0;
+    for (const auto& [bpm,votes]:timing.mainVotes) {
+        if (votes>highest) { highest=votes; mainBpm=bpm; }
+    }
+    if (mainBpm<=0.) return 0.;
+    constexpr double width=.01;
+    struct Onset { double position, amplitude; std::size_t keys; };
+    std::array<std::vector<Onset>,2> sides;
+    std::array<std::size_t,2> start{};
+    std::size_t tempo=0;
+    double load=0.;
+    for (std::size_t i=0;i<notes.size();) {
+        const double time=notes[i].start;
+        std::size_t end=i+1;
+        while (end<notes.size() && notes[end].start==time) ++end;
+        while (tempo+1<timing.tempos.size() && timing.tempos[tempo+1].first<=time) ++tempo;
+        const double bpm=timing.tempos[tempo].second;
+        if (bpm!=mainBpm) {
+            const std::size_t side=bpm>mainBpm ? 1 : 0;
+            const Onset row{(time-first)/duration, std::abs(bpm-mainBpm)/std::max(bpm,mainBpm), end-i};
+            auto& rows=sides[side];
+            auto& left=start[side];
+            while (left<rows.size() && rows[left].position<=row.position-width) ++left;
+            const double begin=std::max(0.,row.position-.5*width);
+            for (std::size_t j=left;j<rows.size();++j) {
+                const auto& previous=rows[j];
+                const double overlap=std::min(1.,previous.position+.5*width)-begin;
+                const double amplitude=std::min(previous.amplitude,row.amplitude);
+                load+=static_cast<double>(row.keys)*previous.keys*amplitude*amplitude*std::max(0.,overlap);
+            }
+            rows.push_back(row);
+        }
+        i=end;
+    }
+    return 100.*std::sqrt(2.*load)/(duration*width);
+}
+} // namespace chart_radar
