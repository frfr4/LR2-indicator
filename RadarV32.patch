+            auto path=std::filesystem::u8path(file);
+            if (!std::filesystem::exists(path)) path=std::filesystem::path(file);
+            const auto seed=static_cast<unsigned>(std::stoul(hash.substr(0,8),nullptr,16));
+            RadarTempo timing;
