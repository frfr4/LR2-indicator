diff --git a/LR2/chart_radar/phrase_radar.hpp b/LR2/chart_radar/phrase_radar.hpp
new file mode 100644
--- /dev/null
+++ b/LR2/chart_radar/phrase_radar.hpp
@@ -0,0 +1,67 @@
+#pragma once
+#include "phrase_load.hpp"
+#include "phrase_parameters.hpp"
+namespace chart_radar::phrases {
+template<std::size_t N>
+inline double interpolate(double x,const double (&xp)[N],const double (&yp)[N],bool clampEnds=false) {
+    if(clampEnds) x=std::clamp(x,xp[0],xp[N-1]);
+    auto upper=std::upper_bound(xp,xp+N,x)-xp;
+    std::size_t i=static_cast<std::size_t>(std::clamp<std::ptrdiff_t>(upper,1,N-1)-1);
+    return yp[i]+(yp[i+1]-yp[i])*(x-xp[i])/(xp[i+1]-xp[i]);
+}
+inline double cents(double x) {return std::nearbyint(x*100.)/100.;}
+inline Scores adjust(Scores scores,const Measures& f) {
+    if(!f.valid) return scores;
+    namespace par=phrase_parameters;
+    constexpr Axis axis[]={Density,Peak,Stair,Jack,Chord,Stamina};
+    std::array<double,6> v{},logV{},shape{};
+    for(int i=0;i<6;++i) v[i]=scores[axis[i]];
+    auto ordered=v;std::sort(ordered.begin(),ordered.end(),std::greater<double>());
+    double sum=0.;
+    for(int i=0;i<4;++i) sum+=ordered[i]*ordered[i];
+    auto demand=[&](int j,const auto& x,const auto& y) {
+        if(f.density[j]<=0.) return 0.;
+        double scaled=std::max(0.,interpolate(std::log1p(f.density[j]),x,y));
+        return par::densityWeights[j]*(scaled-std::log1p(std::sqrt(sum)));
+    };
+    double pressure=demand(0,par::density0X,par::density0Y)+demand(1,par::density1X,par::density1Y)+demand(2,par::density2X,par::density2Y);
+    pressure=par::densityBound*std::tanh(pressure/par::densityBound);
+    for(int i=0;i<6;++i) {
+        v[i]=cents(v[i]*std::exp(pressure+par::scales[i]));
+        logV[i]=std::log1p(v[i]);shape[i]=par::shapeWeights[i][0];
+        for(int j=0;j<3;++j) {
+            auto knots=par::shapeKnots[i];
+            double t=(logV[i]-knots[j])/std::max(.05,knots[j+1]-knots[j]);
+            shape[i]+=par::shapeWeights[i][j+1]*std::clamp(t,0.,1.);
+        }
+    }
+    for(const auto& p:par::terms) {
+        const auto b=p.expected;
+        double normal=b[0]+b[1]*logV[p.axis]+b[2]*std::log1p(f.density[0]);
+        shape[p.axis]+=p.weight*std::clamp((std::log1p(f.technique[p.feature])-normal)/p.deviation,-3.,3.);
+    }
+    const double limit=std::log(1.5);
+    for(int i=0;i<6;++i) {
+        double shaped=cents(v[i]*std::exp(limit*std::tanh(shape[i]/limit)));
+        scores[axis[i]]=cents(std::sqrt(v[i]*shaped));
+    }
+    auto jackEvidence=[](double input) {
+        return std::expm1(interpolate(std::log1p(input),par::jackX,par::jackY,true));
+    };
+    double mapped=jackEvidence(f.strict),delta=mapped-scores[Jack];
+    scores[Jack]=cents(std::max(0.,scores[Jack]+par::jackMix*delta+
+        std::min(.25*par::jackMix,1.-par::jackMix)*std::max(0.,delta)));
+    // Both decisions use the unmodified baseline so neither correction feeds back on the other.
+    double maximum=*std::max_element(scores.begin(),scores.end()),other=0.;
+    for(int j=0;j<Count;++j) if(j!=Peak) other=std::max(other,scores[j]);
+    double proportion=scores[Jack]/std::max(maximum,1.e-10);
+    scores[Jack]=cents(scores[Jack]+par::relaxedShare*par::jackMix*
+        std::max(0.,jackEvidence(f.relaxed)-mapped)*proportion*proportion);
+    double physical=std::max(0.,interpolate(std::log1p(f.broad),par::peakX,par::peakY));
+    double deficit=std::max(0.,std::log1p(scores[Peak])-physical);
+    double infrequent=std::max(0.,std::log(std::max(1.e-8,f.paired)/std::max(1.e-8,f.covered)));
+    double lead=std::max(0.,1.-other/std::max(1.e-10,scores[Peak]));
+    scores[Peak]=cents(scores[Peak]*std::exp(-par::peakCut*std::tanh(lead*(deficit+2.*infrequent))));
+    return scores;
+}
+}
