diff --git a/LR2/chart_radar/phrase_load.hpp b/LR2/chart_radar/phrase_load.hpp
new file mode 100644
--- /dev/null
+++ b/LR2/chart_radar/phrase_load.hpp
@@ -0,0 +1,152 @@
+// Physical evidence for the seven-key radar. Input is sorted, deduplicated playable heads.
+#pragma once
+#include "radar.hpp"
+#include <numeric>
+#include <limits>
+namespace chart_radar::phrases {
+using Series = std::vector<double>;
+inline double quantile(Series values,double q) {
+    if(values.empty()) return 0.;
+    std::sort(values.begin(),values.end());
+    double p=q*(values.size()-1);
+    auto i=static_cast<std::size_t>(p);
+    return values[i]+(p-i)*(values[std::min(i+1,values.size()-1)]-values[i]);
+}
+struct Windows {
+    const Series& time;
+    Series prefix;
+    explicit Windows(const Series& t,const Series& loads):time(t),prefix(loads.size()+1) {
+        std::partial_sum(loads.begin(),loads.end(),prefix.begin()+1);
+    }
+    double rate(double start,double width,double slack) const {
+        auto lo=std::lower_bound(time.begin(),time.end(),start-slack)-time.begin();
+        auto hi=std::upper_bound(time.begin(),time.end(),start+width+1.e-9)-time.begin();
+        return (prefix[hi]-prefix[lo])/width;
+    }
+    Series uniform(double fraction,bool absolute=false) const {
+        const double duration=time.back()-time.front(),width=duration*fraction;
+        const double first=time.front(),last=absolute?(first+duration-width):(time.back()-width);
+        Series result(401);
+        for(int i=0;i<=400;++i) {
+            double start=i==400?last:first+i*((last-first)/400.);
+            result[i]=rate(start,width,absolute?0.:1.e-9);
+        }
+        return result;
+    }
+    double centeredPeak(double fraction) const {
+        double duration=time.back()-time.front(),width=duration*fraction,peak=0.;
+        for(double t:time) peak=std::max(peak,rate(std::clamp(t-width*.5,time.front(),time.back()-width),width,1.e-9));
+        return peak;
+    }
+    double combinedPeak(double f,double g) const {return std::sqrt(centeredPeak(f)*centeredPeak(g));}
+};
+inline double highest(const Series& x) {return *std::max_element(x.begin(),x.end());}
+inline int bits(unsigned v) {return static_cast<int>(std::bitset<8>(v).count());}
+struct Measures {
+    // density, peak and stamina of the published HARD calibration.
+    std::array<double,3> density{};
+    // roll burst / sustain, 8-head q95, three-hit q99, five-hit maximum,
+    // three-hit sustain, accompanied repeats, chord changes burst / sustain, chord coverage.
+    std::array<double,10> technique{};
+    double strict=0.,relaxed=0.,edge=0.,paired=0.,broad=0.,covered=0.;
+    bool valid=false;
+};
+inline Measures measure(const std::vector<Note>& notes) {
+    Measures out;
+    if(notes.size()<2) return out;
+    std::vector<long long> us; std::vector<unsigned> masks;
+    for(const auto& note:notes) {
+        auto tick=std::llround(note.start*1000000.);
+        if(us.empty() || tick!=us.back()){us.push_back(tick);masks.push_back(0);}
+        if(note.lane>=0 && note.lane<7) masks.back()|=1u<<note.lane;
+    }
+    if(us.size()<2 || us.front()>=us.back()) return out;
+    const auto n=us.size();
+    Series t(n),absolute(n),pulseTime(n),keys(n),chord(n),move(n),roll(n),accomp(n),threeMax(n),heads,threeHz;
+    std::array<Series,3> energy{Series(n),Series(n),Series(n)};
+    std::array<std::vector<std::size_t>,7> lanes;
+    unsigned last=0,prev=0;std::size_t lastIx=0; double previousGap=0;
+    for(std::size_t i=0;i<n;++i) {
+        absolute[i]=us[i]/1000000.;t[i]=(us[i]-us.front())/1000000.;pulseTime[i]=us[i]*1.e-6;
+        unsigned now=masks[i];keys[i]=bits(now);chord[i]=std::max(0.,keys[i]-1.);
+        if(!now) continue;
+        heads.insert(heads.end(),static_cast<std::size_t>(keys[i]),t[i]);
+        for(int k=0;k<7;++k) if(now&(1u<<k)) lanes[k].push_back(i);
+        if(last) {
+            double gap=t[i]-t[lastIx];int shared=bits(last&now);
+            accomp[i]=shared*std::log1p(bits(now&~last))/gap;
+            int width=std::min(bits(last),bits(now));
+            if(width>=2) move[i]=width-shared;
+            if(prev) {
+                auto up=(prev<<2)&(last<<1)&now, down=(prev>>2)&(last>>1)&now;
+                roll[i]=(bits(up)+bits(down))/std::max(gap,previousGap);
+            }
+            previousGap=gap;
+        }
+        prev=last;last=now;lastIx=i;
+    }
+    if(heads.empty()) return out;
+    for(const auto& hits:lanes) {
+        for(std::size_t end=1;end<hits.size();++end) {
+            double strict=0.;std::array<double,2> extra{};
+            for(std::size_t intervals=1;intervals<=2 && intervals<=end;++intervals) {
+                const auto start=end-intervals;
+                const double lastGap=pulseTime[hits[end]]-pulseTime[hits[end-1]];
+                const double firstGap=pulseTime[hits[start+1]]-pulseTime[hits[start]];
+                const double slow=std::max(lastGap,firstGap),ratio=std::min(firstGap,lastGap)/slow;
+                auto flank=[&](double gap){return std::clamp(std::log2(gap/slow),0.,1.);};
+                double left=start?flank(pulseTime[hits[start]]-pulseTime[hits[start-1]]):1.;
+                double right=end+1<hits.size()?flank(pulseTime[hits[end+1]]-pulseTime[hits[end]]):1.;
+                const double iso=std::min(left,right),edge=std::max(left,right);
+                const double old=std::pow(iso*ratio*intervals/slow,2);
+                strict+=old;
+                for(int k=0;k<2;++k) {
+                    double loose=(iso+(k+1)*.5*(edge-iso))*std::sqrt(ratio)*intervals/slow;
+                    extra[k]=std::max(extra[k],loose*loose-old);
+                }
+            }
+            energy[0][hits[end]]+=strict;
+            for(int k=0;k<2;++k) energy[k+1][hits[end]]+=strict+extra[k];
+            if(end>=2) {
+                double gap=0.;
+                for(std::size_t j=end-1;j<=end;++j) gap=std::max(gap,t[hits[j]]-t[hits[j-1]]);
+                double hz=1./gap;threeHz.push_back(hz);threeMax[hits[end]]=std::max(threeMax[hits[end]],hz);
+            }
+            if(end>=4) {
+                double gap=0.;
+                for(std::size_t j=end-3;j<=end;++j) gap=std::max(gap,t[hits[j]]-t[hits[j-1]]);
+                out.technique[4]=std::max(out.technique[4],1./gap);
+            }
+        }
+    }
+    const double duration=t.back();Windows counts(absolute,keys);
+    auto one=counts.uniform(.01,true),five=counts.uniform(.05,true),fifteen=counts.uniform(.15,true);
+    out.density={std::sqrt(quantile(five,.9)*heads.size()/(absolute.back()-absolute.front())),
+                 std::sqrt(highest(one)*highest(five)),std::sqrt(highest(fifteen)*quantile(fifteen,.9))};
+    Windows rolls(t,roll),moves(t,move);
+    out.technique[0]=rolls.combinedPeak(.0025,.01);out.technique[1]=rolls.combinedPeak(.04,.12);
+    Series speed8;
+    for(std::size_t j=8;j<heads.size();++j) speed8.push_back(8./std::max(1.e-6,heads[j]-heads[j-8]));
+    out.technique[2]=quantile(speed8,.95);out.technique[3]=quantile(threeHz,.99);
+    out.technique[5]=Windows(t,threeMax).combinedPeak(.04,.12);
+    out.technique[6]=Windows(t,accomp).combinedPeak(.04,.12);
+    out.technique[7]=moves.combinedPeak(.0025,.01);out.technique[8]=moves.combinedPeak(.04,.12);
+    out.technique[9]=quantile(Windows(t,chord).uniform(.04),.9);
+    std::array<double*,3> fields{&out.strict,&out.relaxed,&out.edge};
+    for(int i=0;i<3;++i) {
+        Windows loads(pulseTime,energy[i]);
+        *fields[i]=std::sqrt(loads.prefix.back()/(pulseTime.back()-pulseTime.front())*quantile(loads.uniform(.12),.9));
+    }
+    Windows keysTimed(pulseTime,keys);Series moments(401);
+    const double D=pulseTime.back()-pulseTime.front();
+    for(int i=0;i<=400;++i) {
+        const double c=i==400?pulseTime.back():pulseTime.front()+i*(D/400.);
+        auto rate=[&](double f){double w=D*f;return keysTimed.rate(std::clamp(c-w*.5,pulseTime.front(),pulseTime.back()-w),w,1.e-9);};
+        double mid=rate(.02),shortRate=rate(.005);
+        moments[i]=std::sqrt(mid*shortRate);
+        out.broad=std::max(out.broad,std::cbrt(mid*shortRate*rate(.06)));
+    }
+    out.paired=highest(moments);out.covered=std::sqrt(out.paired*quantile(moments,.95));
+    out.valid=true;return out;
+}
+} // namespace chart_radar::phrases
