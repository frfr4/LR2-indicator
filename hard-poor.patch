+// As in the gameplay loader, a press inside an active hold on the same lane
+// does not add a judgment. The decoder has already merged simultaneous heads.
+inline int gaugeNoteCount(const DecodedChart& chart) {
+    std::array<double, 18> occupiedUntil;
+    occupiedUntil.fill(-std::numeric_limits<double>::infinity());
+    int count = 0;
+    for (const auto& n : chart.notes) {
+        if (n.start <= occupiedUntil[n.lane]) continue;
+        occupiedUntil[n.lane] = n.end;
+        ++count;
+    }
+    return count;
+}
