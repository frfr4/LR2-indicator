diff --git a/LR2/chart_radar/gauge_reference.hpp b/LR2/chart_radar/gauge_reference.hpp
index 918e002..7d0cc25 100644
--- a/LR2/chart_radar/gauge_reference.hpp
+++ b/LR2/chart_radar/gauge_reference.hpp
@@ -1,4 +1,5 @@
 #pragma once
+#include <algorithm>
 #include <cmath>
 
 namespace chart_radar {
@@ -8,4 +9,25 @@ inline double defaultGaugeTotal(double heads) {
                       heads<600.?280.+(heads-400.)/2.5:360.+(heads-600.)/5.;
     return std::floor(.8*base);
 }
+
+// Multiplier used by the gameplay judgment table, before low-HP mitigation.
+inline double hardDamageMultiplier(int notes, int total) {
+    double noteBase;
+    if (notes < 20) noteBase = 10.;
+    else if (notes < 30) noteBase = 10. - (notes - 20.) / 10. * 2.;
+    else if (notes < 45) noteBase = 7. - (notes - 30.) / 15.;
+    else if (notes < 60) noteBase = 6. - (notes - 45.) / 15.;
+    else if (notes < 125) noteBase = 5. - (notes - 60.) / 65.;
+    else if (notes < 250) noteBase = 4. - (notes - 125.) / 125.;
+    else if (notes < 500) noteBase = 3. - (notes - 250.) / 250.;
+    else if (notes < 1000) noteBase = 2. - (notes - 500.) / 500.;
+    else noteBase = 1.;
+    const int recovery = std::max(1, (total - 80) / 16);
+    return std::max(noteBase * 10., 100. / recovery) / 10.;
+}
+
+inline int extraPoorCents(int notes, int headerTotal) {
+    const int total = headerTotal > 0 ? headerTotal : static_cast<int>(defaultGaugeTotal(notes));
+    return static_cast<int>(std::lround(100. * (10. * hardDamageMultiplier(notes, total) - 10.)));
+}
 }
